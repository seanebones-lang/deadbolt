DEADBOLT_TOKEN=
# DEADBOLT_SOCK=127.0.0.1:9782
# DEADBOLT_DB and DEADBOLT_EVENTS override CLI store paths; the systemd unit sets them.
# Unreleased source refuses Unix and TCP serve when this token is empty.
# Supply a fresh private token; do not enable legacy Unix authority in production.
# Published rc.1/1.x require it for TCP; configure it for Unix as well.
# Install this file as /etc/deadbolt/deadbolt.env mode 0600.
